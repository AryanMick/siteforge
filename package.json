{
  "name": "siteforge-benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic synthetic websites and private ground truth for crawler benchmarks",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "bin": {
    "siteforge": "./src/cli.mjs"
  },
  "scripts": {
    "verify": "node scripts/verify-pagepilot.mjs",
    "pagepilot": "node scripts/start-pagepilot.mjs",
    "siteforge": "node scripts/start-pagepilot.mjs",
    "gateway": "node scripts/fixture-gateway.mjs",
    "audit:job": "node scripts/audit-fixture-job.mjs",
    "test:generator-ui": "node scripts/check-fixture-lab.mjs",
    "test:generator-recovery": "node scripts/check-fixture-lab-recovery.mjs",
    "test:generator-navigation": "node scripts/check-fixture-lab-navigation.mjs",
    "test:generator-redesign": "node scripts/check-fixture-redesign.mjs",
    "test:generator-api": "node --import tsx --test test/fixture-lab-routes.test.ts test/evaluator-handoff-route.test.ts",
    "test:field-locations": "node scripts/check-field-locations.mjs",
    "test:realistic-locations": "node scripts/check-realistic-locations.mjs",
    "test:cms-theme": "node scripts/check-cms-theme.mjs",
    "benchmark:baseline": "node scripts/benchmark-baseline.mjs",
    "test:score-upload": "node scripts/check-score-upload.mjs",
    "test:cms-markup": "node scripts/check-cms-markup.mjs",
    "test:link-noise": "node scripts/check-link-noise.mjs",
    "test:base-relative": "node scripts/check-base-relative.mjs",
    "test:preview-rebase": "node scripts/check-preview-rebase.mjs",
    "test:catalog": "node scripts/check-case-catalog.mjs",
    "test:catalog-ui": "node scripts/check-catalog-ui.mjs",
    "catalog:run": "node scripts/run-case-catalog.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 4400",
    "build": "next build --webpack && node scripts/check-runtime-artifacts.mjs",
    "start": "next start --hostname 127.0.0.1 --port 4400",
    "typecheck": "tsc --noEmit",
    "test:bdd": "cucumber-js --config cucumber.mjs",
    "test:mutation": "stryker run stryker.config.mjs",
    "test:mutation:generator": "stryker run stryker.generator.config.mjs",
    "test:mutation:repeated": "stryker run stryker.repeated.config.mjs",
    "test:mutation:scoring": "stryker run stryker.scoring.config.mjs",
    "test:workbench": "node --import tsx --test test/workbench.test.ts",
    "test:pagepilot": "node --test test/pagepilot.test.mjs && node --import tsx --test test/pagepilot-routes.test.ts test/pagepilot-wordpress-route.test.ts",
    "test:pagepilot-ui": "node scripts/check-fixture-lab.mjs",
    "test:public-sites": "node scripts/check-public-sites.mjs",
    "test:ui": "node scripts/check-workbench.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:legacy-browser": "node scripts/check-legacy-browser.mjs",
    "study": "node scripts/site-study.mjs",
    "study:references": "node scripts/reference-study.mjs",
    "test:reference-browser": "node scripts/check-reference-browser.mjs",
    "demo": "node src/cli.mjs generate examples/library.yaml --out outputs/library-clean",
    "demo:noisy": "node src/cli.mjs generate examples/library.yaml --noise high --out outputs/library-high",
    "serve": "node src/cli.mjs serve outputs/library-clean --port 4310",
    "benchmark:scale": "node scripts/scale-check.mjs"
  },
  "dependencies": {
    "@angular/common": "20.3.32",
    "@angular/compiler": "20.3.32",
    "@angular/core": "20.3.32",
    "@angular/platform-browser": "20.3.32",
    "@axe-core/playwright": "4.13.0",
    "@crawlee/basic": "3.18.2",
    "@crawlee/core": "3.18.2",
    "@cucumber/gherkin": "42.0.0",
    "@cucumber/messages": "34.2.0",
    "@exodus/bytes": "1.16.0",
    "@faker-js/faker": "10.6.0",
    "adm-zip": "0.6.1",
    "esbuild": "0.25.10",
    "html-encoding-sniffer": "6.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.48.0",
    "ml-hclust": "4.0.0",
    "next": "16.3.8",
    "parse5": "7.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "rxjs": "7.8.2",
    "undici": "7.29.1",
    "yaml": "2.9.1",
    "zip-stream": "7.0.5",
    "zod": "3.25.76",
    "zone.js": "0.15.1"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "playwright": "1.55.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yauzl": "3.4.0"
  }
}
