# Copy to docker/.env to change a value. Everything here is the default, so the file is optional.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
# Address of the WordPress on your computer: http://localhost:8080
SITEFORGE_WP_DOCKER_PORT=8080
# WordPress admin login (created on the first start)
SITEFORGE_WP_DOCKER_ADMIN=admin
SITEFORGE_WP_DOCKER_ADMIN_PASSWORD=password
