# Settings for the Docker WordPress (npm run wordpress:docker). Copy this file to docker/.env to change them;
# without docker/.env these defaults are used.
SITEFORGE_WP_DOCKER_PORT=8080
SITEFORGE_WP_DOCKER_ADMIN=admin
SITEFORGE_WP_DOCKER_ADMIN_PASSWORD=password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
